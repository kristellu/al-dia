{
  "name": "al-dia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Control financiero personal por quincenas. Cloudflare Pages + Functions + D1.",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create al-dia",
    "db:migrate": "wrangler d1 migrations apply al-dia --remote",
    "db:migrate:local": "wrangler d1 migrations apply al-dia --local",
    "user:create": "node scripts/create-user.mjs",
    "user:create:local": "node scripts/create-user.mjs --local",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "wrangler": "4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
