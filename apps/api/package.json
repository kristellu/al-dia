{
  "name": "@al-dia/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API de Al día: Cloudflare Pages Functions + D1. Sirve también los estáticos de @al-dia/web.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler pages dev ../web/public",
    "deploy": "npm run build && wrangler pages deploy",
    "db:create": "wrangler d1 create db-aldia",
    "db:migrate": "wrangler d1 migrations apply db-aldia --remote",
    "db:migrate:local": "wrangler d1 migrations apply db-aldia --local",
    "user:create": "node scripts/create-user.mjs",
    "user:create:local": "node scripts/create-user.mjs --local"
  },
  "devDependencies": {
    "wrangler": "4.40.0"
  }
}
